ASRO_SEC_USER_AGENT="AI-Systemic-Risk-Observatory/0.1 your-email@example.com"
ASRO_DATABASE_PATH="data/monitor.db"
# ASRO_CONFIG_PATH="/path/to/your/config.toml"   # defaults to the packaged src/asro/default.toml

ASRO_POLL_INTERVAL_MINUTES=60
# Keep the real value in a local .env or GitHub Actions secret. Never commit it.
ASRO_OPENAI_API_KEY=""
# Needed for point-in-time (ALFRED vintage) macro data. Free from
# https://fredaccount.stlouisfed.org/apikeys . Without it, revised series such as GDP,
# unemployment and C&I lending cannot be retrieved as they stood on a historical date,
# and the historical calibration gate will refuse to certify.
ASRO_FRED_API_KEY=

ASRO_REVIEW_MODEL="gpt-4.1-mini"
